# ─────────────────────────────────────────────────────────────────────────────
# Frontend build (Vite) — public values only, they end up in the JS bundle.
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# optional, defaults to ${VITE_SUPABASE_URL}/functions/v1
VITE_FUNCTIONS_URL=
# public half of the VAPID pair (npm run vapid:generate); empty = push UI hidden
VITE_VAPID_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Tenant pipeline scripts (tenant:publish / tenant:verify / tenant:member)
# Run only on a trusted machine or CI. NEVER expose the service role key.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─────────────────────────────────────────────────────────────────────────────
# Edge Function secrets — set with `supabase secrets set --env-file …`,
# not in this file in production. SUPABASE_URL / *_KEY are injected by Supabase.
# ─────────────────────────────────────────────────────────────────────────────
# AI assistant (any OpenAI-compatible /chat/completions endpoint)
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TOOL_MODE=tools            # tools | json (JSON-intent fallback for models without function calling)
LLM_MAX_STEPS=4
LLM_TIMEOUT_MS=25000
AI_GLOBAL_DAILY_REQUESTS=5000  # hard cap across all tenants
AI_GLOBAL_DAILY_TOKENS=5000000

# Web Push (RFC 8292 VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# shared secret between Supabase Cron and notify-worker (random, ≥ 32 chars)
CRON_SECRET=
